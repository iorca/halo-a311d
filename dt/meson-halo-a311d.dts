// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Althea A311D (MAIN_V0.3) — USB3.0 变体
 * 派生自 Khadas VIM3，骨架为 mainline 6.18。
 * 另一变体：meson-halo-a311d-pcie.dts（&pcie okay / &usb disabled）。
 * 两者只差 FUSB340 对 usb3_pcie_phy 的归属，见 docs/冷切换使用说明.md。
 */

/dts-v1/;

#include <dt-bindings/gpio/meson-g12a-gpio.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/amlogic,meson-g12a-gpio-intc.h>
/* 只 include a311d 一份：s922x 的同名 opp-table 会被 dtc 合并成混搭表 */
#include "meson-g12b-a311d.dtsi"

/ {
	model = "Althea A311D (MAIN_V0.3)";
	compatible = "althea,a311d", "amlogic,a311d", "amlogic,g12b";

	aliases {
		serial0 = &uart_AO;
		ethernet0 = &ethmac;
		/* 无外置 RTC，用 SoC vrtc */
		rtc0 = &vrtc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* 大核 A73 供电：MP8756GD，pwm_ab 通道 A */
	vddcpu_a: regulator-vddcpu-a {
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU_A";
		regulator-min-microvolt = <690000>;
		regulator-max-microvolt = <1050000>;

		pwm-supply = <&dc_in>;
		pwms = <&pwm_ab 0 1250 0>;
		pwm-dutycycle-range = <100 0>;

		regulator-boot-on;
		regulator-always-on;
	};

	/* 小核 A53 供电：SY8030DEC，pwm_AO_cd 通道 D */
	vddcpu_b: regulator-vddcpu-b {
		compatible = "pwm-regulator";
		regulator-name = "VDDCPU_B";
		regulator-min-microvolt = <690000>;
		regulator-max-microvolt = <1050000>;

		pwm-supply = <&vsys_3v3>;
		pwms = <&pwm_AO_cd 1 1250 0>;
		pwm-dutycycle-range = <100 0>;

		regulator-boot-on;
		regulator-always-on;
	};

	dc_in: regulator-dc-in {
		compatible = "regulator-fixed";
		regulator-name = "DC_IN";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	vsys_3v3: regulator-vsys-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VSYS_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_in>;
		regulator-always-on;
	};

	vcc_5v: regulator-vcc-5v {
		compatible = "regulator-fixed";
		regulator-name = "VCC_5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_in>;
		regulator-always-on;
	};

	/* MT9700 EN 已改电阻上拉常开 → GPIOAO_11 释放，不做 GPIO 使能 */
	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vsys_3v3>;
		regulator-always-on;
	};

	vddao_1v8: regulator-vddao-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "VDDIO_AO1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vsys_3v3>;
		regulator-always-on;
	};

	emmc_1v8: regulator-emmc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "EMMC_AO1V8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc_3v3>;
		regulator-always-on;
	};

	/* LED4: NPN 低边开关，高电平点亮 → GPIO_ACTIVE_HIGH。
	 * 属性名必须是 linux,default-trigger / default-state（旧名内核不读）。 */
	leds {
		compatible = "gpio-leds";

		run_led {
			label = "run";
			gpios = <&gpio_ao GPIOAO_10 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};
	};

	ir-receiver {
		compatible = "gpio-ir-receiver";
		gpios = <&gpio_ao GPIOAO_5 GPIO_ACTIVE_LOW>;
	};

	/* eMMC 上电时序 */
	emmc_pwrseq: emmc-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		reset-gpios = <&gpio BOOT_12 GPIO_ACTIVE_LOW>;
	};

	/* SDIO (AP6256) 上电时序 —— 用 GPIOX_6 */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio GPIOX_6 GPIO_ACTIVE_LOW>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		/* WL_REG_ON 释放后等待 AP6256 上电稳定 */
		post-power-on-delay-ms = <100>;
	};

	/* 32.768kHz 时钟（AP6256 需求） */
	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>; /* PWM_E at 32.768KHz */
	};

	/* 风扇 PWM：pwm_AO_cd 的 D 通道已被 vddcpu_b 占用，改用 pwm_AO_ab(A)/GPIOAO_11。
	 * 驱动电路 layout 未完成，本节点仅预留通道，风扇不会转。 */
	fan_pwm: fan-pwm {
		compatible = "pwm-fan";
		pwms = <&pwm_AO_ab 0 1250 0>;
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

};

&cpu0 {
	cpu-supply = <&vddcpu_b>;      /* A53 小核 */
	operating-points-v2 = <&cpu_opp_table_0>;
	clocks = <&clkc CLKID_CPU_CLK>;
};

&cpu1 {
	cpu-supply = <&vddcpu_b>;
	operating-points-v2 = <&cpu_opp_table_0>;
	clocks = <&clkc CLKID_CPU_CLK>;
};

&cpu100 {
	cpu-supply = <&vddcpu_a>;      /* A73 大核 */
	operating-points-v2 = <&cpub_opp_table_1>;
	clocks = <&clkc CLKID_CPUB_CLK>;
};

&cpu101 {
	cpu-supply = <&vddcpu_a>;
	operating-points-v2 = <&cpub_opp_table_1>;
	clocks = <&clkc CLKID_CPUB_CLK>;
};

&cpu102 {
	cpu-supply = <&vddcpu_a>;
	operating-points-v2 = <&cpub_opp_table_1>;
	clocks = <&clkc CLKID_CPUB_CLK>;
};

&cpu103 {
	cpu-supply = <&vddcpu_a>;
	operating-points-v2 = <&cpub_opp_table_1>;
	clocks = <&clkc CLKID_CPUB_CLK>;
};

/* pwm_ab 通道0(A) → GPIOE_2 = VDDCPU_A_PWM（大核 A73） */
&pwm_ab {
	pinctrl-0 = <&pwm_a_e_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* pwm_AO_cd 通道1(D) → GPIOE_1 = VDDCPU_B_PWM（小核 A53） */
&pwm_AO_cd {
	pinctrl-0 = <&pwm_ao_d_e_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* pwm_AO_ab 通道0(A) → GPIOAO_11 = 散热风扇 PWM */
&pwm_AO_ab {
	pinctrl-0 = <&pwm_ao_a_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* YT8531H-CA @ MDIO addr 1（VIM3 是 0）。
 * phy-mode="rgmii" + amlogic,tx-delay-ns=<2>；不要写 rx-internal-delay-ps，
 * 不要用 rgmii-id/rgmii-rxid，底板 R62/R70 不贴（真机 1Gbps 验证）。 */
&ethmac {
	pinctrl-0 = <&eth_pins>, <&eth_rgmii_pins>;
	pinctrl-names = "default";
	status = "okay";
	phy-mode = "rgmii";
	phy-handle = <&external_phy>;
	amlogic,tx-delay-ns = <2>;
};

&ext_mdio {
	external_phy: ethernet-phy@1 {   /* ⚠ 非 VIM3 的 @0 */
		reg = <1>;
		max-speed = <1000>;

		/* RGMII_INT: GPIOZ_14，低有效 → 下降沿 */
		interrupt-parent = <&gpio_intc>;
		interrupts = <IRQID_GPIOZ_14 IRQ_TYPE_EDGE_FALLING>;

		/* LED1(绿)/LED2(黄) 与 CFG_LDO 复用；0x2670 = 任意速率链路 + 活动，
		 * 0x2640 = 1000M 链路 + 活动。需 patch/apply/meson64-6.18 的 motorcomm LED 支持。 */
		motorcomm,led1-config = <0x2670>;
		motorcomm,led2-config = <0x2640>;
	};
};

/* FUSB340 SEL(GPIOA_2) 决定 usb3_pcie_phy 归 PCIe 还是 USB3.0。
 * PHY 归属在 DTB 编译期定死，不能运行期热切换；冷切换由 U-Boot 按 strap
 * 选 fdtfile，见 docs/冷切换使用说明.md。 */

/* SPI_B 控制器 = SPI1，GPIOH_4~7 */
/* SS0 是独立 pinctrl 组，需单独列出 */
&spicc1 {
	status = "okay";

	pinctrl-0 = <&spicc1_pins>, <&spicc1_ss0_pins>;
	pinctrl-names = "default";

	num-cs = <1>;
	cs-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_LOW>;	/* SPI_B_SS0 = GPIOH_6 */

	/* ST7735S 共用 fbtft 的 fb_st7735r（v6.18 无单独 st7735s）。
	 * 极性依 fbtft-core.c：RST/LED 低有效、DC 高有效；buswidth=8 必填。 */
	display@0 {
		compatible = "sitronix,st7735r";
		reg = <0>;
		spi-max-frequency = <8000000>;
		reset-gpios = <&gpio GPIOA_3 GPIO_ACTIVE_LOW>;
		dc-gpios = <&gpio GPIOA_4 GPIO_ACTIVE_HIGH>;
		led-gpios = <&gpio GPIOH_8 GPIO_ACTIVE_LOW>;
		buswidth = <8>;
	};
};

/* FUSB340 SEL 电平由板上选贴的上/下拉决定，U-Boot 读它选 dtb。
 * hog 必须是 gpio-controller 的子节点，且必须显式写 input（不驱动 strap）。
 * input hog 会占用该线，userspace 无法再 export。 */
&gpio {
	fusb340-sel-hog {
		gpio-hog;
		gpios = <GPIOA_2 GPIO_ACTIVE_HIGH>;
		input;
		line-name = "FUSB340_SEL";
	};
};

/* U42 SHT40 —— I2C3 @ GPIOA_14(SDA)/GPIOA_15(SCL) */
&i2c3 {
	status = "okay";
	pinctrl-0 = <&i2c3_sda_a_pins>, <&i2c3_sck_a_pins>;
	pinctrl-names = "default";
	clock-frequency = <100000>;

	sht40_ee: sht40@44 {
		compatible = "sensirion,sht4x";
		reg = <0x44>;
	};
};

/* AO 域 I2C 控制器保留但不挂设备：U45 的 SDA/SCL 在网表上悬空，
 * 板上也没有 RTC 芯片。 */
&i2c_AO {
	status = "okay";
	pinctrl-0 = <&i2c_ao_sck_pins>, <&i2c_ao_sda_pins>;
	pinctrl-names = "default";
};

&sd_emmc_a {
	status = "okay";
	pinctrl-0 = <&sdio_pins>;
	pinctrl-1 = <&sdio_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";
	#address-cells = <1>;
	#size-cells = <0>;

	bus-width = <4>;
	cap-sd-highspeed;
	/* 25MHz：50MHz 下 F1 backplane 读回全 0xff（信号完整性），真机 25MHz
	 * F1=0x15294345、wlan0 可用。不要调回 100MHz，也不要改 1-bit。 */
	max-frequency = <25000000>;

	non-removable;
	disable-wp;
	keep-power-in-suspend;   /* WiFi 固件要求挂起时保持供电 */

	mmc-pwrseq = <&sdio_pwrseq>;

	vmmc-supply = <&vsys_3v3>;
	vqmmc-supply = <&vddao_1v8>;

	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
	};
};

&sd_emmc_b {
	status = "okay";
	pinctrl-0 = <&sdcard_c_pins>;
	pinctrl-1 = <&sdcard_clk_gate_c_pins>;
	pinctrl-names = "default", "clk-gate";

	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <50000000>;
	disable-wp;

	vmmc-supply = <&vsys_3v3>;
	vqmmc-supply = <&vsys_3v3>;
};

&sd_emmc_c {
	status = "okay";
	pinctrl-0 = <&emmc_ctrl_pins>, <&emmc_data_8b_pins>, <&emmc_ds_pins>;
	pinctrl-1 = <&emmc_clk_gate_pins>;
	pinctrl-names = "default", "clk-gate";

	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	max-frequency = <200000000>;
	disable-wp;

	mmc-pwrseq = <&emmc_pwrseq>;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&emmc_1v8>;
};

&hdmi_tx {
	status = "okay";
	pinctrl-0 = <&hdmitx_hpd_pins>, <&hdmitx_ddc_pins>;
	pinctrl-names = "default";
	hdmi-supply = <&vcc_5v>;
};

&hdmi_tx_tmds_port {
	hdmi_tx_tmds_out: endpoint {
		remote-endpoint = <&hdmi_connector_in>;
	};
};

/* CEC：底板经 Q6/Q7(MS3134) 电平转换 → CN1-51/49 */
&cec_AO {
	pinctrl-0 = <&cec_ao_a_h_pins>;
	pinctrl-names = "default";
	status = "okay";
	hdmi-phandle = <&hdmi_tx>;
};

&usb2_phy0 {
	phy-supply = <&dc_in>;
};

&usb2_phy1 {
	phy-supply = <&vcc_5v>;
};

&usb3_pcie_phy {
	phy-supply = <&vcc_5v>;
};

/* glue 的 dr_mode 决定 usb2_phy1 的 U2P_R0_HOST_DEVICE：peripheral 会让
 * OTG 口进 device 模式，两条 USB 路径都不枚举。必须 host。 */
&usb {
	status = "okay";
	dr_mode = "host";
};

&pcie {
	status = "disabled";
};

&uart_A {
	status = "okay";
	pinctrl-0 = <&uart_a_pins>, <&uart_a_cts_rts_pins>;
	pinctrl-names = "default";
	uart-has-rtscts;

	/* BT_REG_ON 由 GPIOA_13 驱动；缺 shutdown-gpios 时该脚被下拉，
	 * BT 永远在复位（BCM: Reset failed -110）。hci_bcm.c 需 ACTIVE_HIGH。 */
	bluetooth {
		compatible = "brcm,bcm43438-bt";
		max-speed = <2000000>;
		clocks = <&wifi32k>;
		clock-names = "lpo";
		shutdown-gpios = <&gpio GPIOA_13 GPIO_ACTIVE_HIGH>;
	};
};

&uart_AO {
	status = "okay";
	pinctrl-0 = <&uart_ao_a_pins>;
	pinctrl-names = "default";
};

&arb {
	status = "okay";
};

&clkc_audio {
	status = "okay";
};

&pwm_ef {
	status = "okay";
	pinctrl-0 = <&pwm_e_pins>;
	pinctrl-names = "default";
};

/* SARADC：SW5 未贴、SARADC_CH0/CH3 悬空 → 不用 adc-keys */
&saradc {
	status = "okay";
	vref-supply = <&vddao_1v8>;
};

/* SPI NOR：与 eMMC 数据线冲突 → 保持 disabled（VIM3 原样） */
&spifc {
	status = "disabled";
};
