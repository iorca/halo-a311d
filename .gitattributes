# FIP 二进制文件较大（合计约 2.8MB），用 LFS 管理
fip/**/*.bin  filter=lfs diff=lfs merge=lfs -text
fip/**/*.img  filter=lfs diff=lfs merge=lfs -text
fip/**/*.fw   filter=lfs diff=lfs merge=lfs -text
fip/aml_encrypt_g12b filter=lfs diff=lfs merge=lfs -text
fip/*.py      text eol=lf

# DTS 与配置
*.dts    text eol=lf
*.dtsi   text eol=lf
*.conf   text eol=lf
*.hush   text eol=lf
*.sh     text eol=lf
*.yml    text eol=lf

# 本仓库的 python 脚本（scripts/ 下）
# ⚠ 与 *.sh 同理：core.autocrlf=true 时工作区会变 CRLF，
#   而 CI 在 Linux 检出拿到 LF —— 同一份脚本字节数不同，
#   本地核对大小会得出错误结论。Python 本身能跑 CRLF，
#   但保持全仓库统一字节更利于比对。
*.py     text eol=lf

# u-boot 引导脚本（boot.cmd 系列）
# ⚠⚠ 必须显式指定 eol=lf：core.autocrlf=true 时，工作区会被转成 CRLF，
#   而 CI 在 Linux 检出拿到 LF —— 同一份文件本地与 CI 字节数不同
#   （boot-meson64.cmd：LF 12348 B vs CRLF 12616 B，差 268 = 行数），
#   本地核对字节数/大小会得出错误结论。
*.cmd    text eol=lf

.gitattributes  text eol=lf
.gitignore    text eol=lf

# 本板厂商 FIP blob（1.5~4MB），用 LFS
# ⚠⚠ 这里原来写成 `fip-blob/**filter=lfs`（**缺空格**），
#   导致 git 完全没把它当属性 → LFS 过滤器从未生效，
#   1.5MB 的 FIP blob 是作为**普通二进制**直接提交进 git 的。
#   `git check-attr filter -- fip-blob` 可以验证这一点。
#   缺空格的后果是"看起来配了 LFS，实际没配" —— 极隐蔽。
fip-blob/** filter=lfs diff=lfs merge=lfs -text
