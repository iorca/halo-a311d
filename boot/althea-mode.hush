echo "MAIN_V0.3 mode select by FUSB340 SEL"

setenv althea_fdt_usb3 /boot/meson-althaea-usb3.dtb
setenv althea_fdt_pcie /boot/meson-althaea-pcie.dtb

gpio read althea_sel FUSB340_SEL

if test "${althea_sel}" = "1"; then
    echo "SEL=HIGH -> PCIe"
    setenv fdt ${althea_fdt_pcie}
else
    echo "SEL=LOW  -> USB3.0"
    setenv fdt ${althea_fdt_usb3}
fi

echo "DT = ${fdt}"
